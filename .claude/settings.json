{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["sap-docs", "sap-abap"],
  "permissions": {
    "allow": [
      "Bash(python scripts/read_cobol.py:*)",
      "Bash(python scripts/collect_deps.py:*)",
      "Edit(./output/**)",
      "Edit(./effort/**)",
      "mcp__sap-docs__search",
      "mcp__sap-docs__fetch",
      "mcp__sap-docs__abap_feature_matrix",
      "mcp__sap-abap__abap_lint"
    ],
    "deny": [
      "Edit(./input/**)",
      "mcp__sap-mcp__DeleteObject",
      "mcp__plugin_sap-mcp_sap-abap__DeleteObject"
    ]
  }
}
